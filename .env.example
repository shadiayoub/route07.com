# Copy this file to .env and fill in your values.
# .env is git-ignored. Never prefix secrets with VITE_.

# Resend API key — create one at https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# Inbox that receives contact form submissions
CONTACT_TO_EMAIL=you@example.com

# Verified sender in Resend. Use onboarding@resend.dev for testing.
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_FROM_NAME=Route07

# Port for the API / production server
PORT=8787

# Set to the number of reverse proxies in front of the app (1 for nginx),
# so rate limiting sees real visitor IPs. Leave 0 for direct access.
TRUST_PROXY=0

